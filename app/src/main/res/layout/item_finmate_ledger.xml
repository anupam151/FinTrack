<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <!-- ICON CONTAINER -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardIconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#E0F2F1"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivTxIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/rupee"
                app:tint="#1abcab"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>

        <!-- TRANSACTION DETAILS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTxTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction Title"
                android:textColor="#082561"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp">

                <!-- Date — Left -->
                <TextView
                    android:id="@+id/tvTxDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 Aug 2026"
                    android:textColor="#949494"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Transaction Number — Right -->
                <TextView
                    android:id="@+id/tvTxNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Txn: #XXXXXX"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp">



                <!-- Payment Source — Left -->
                <TextView
                    android:id="@+id/tvTxSource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Paid via: Cash"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="start" />



            </LinearLayout>



        </LinearLayout>

        <!-- AMOUNT & STATUS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <!-- FinMate's Specific Split Amount -->
            <TextView
                android:id="@+id/tvTxAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#082561"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Payment Status Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/badgeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#FFF3E0"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvTxStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Unpaid"
                    android:textColor="#FF9800"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Total Transaction Amount (Visible only if split > 1) -->
            <TextView
                android:id="@+id/tvTxTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Total: ₹0.00"
                android:textColor="#949494"
                android:textSize="11sp"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>