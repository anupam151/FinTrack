<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingVertical="8dp"
    tools:ignore="HardcodedText, TooManyViews, SmallSp, ContentDescription, UseCompoundDrawables, TooDeepLayout">

    <androidx.cardview.widget.CardView
        android:id="@+id/finmateAvatarContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardBackgroundColor="#1abcab"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvFinmateInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="AB"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ivFinmateArrow"
        app:layout_constraintStart_toEndOf="@id/finmateAvatarContainer"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvFinmateName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Person Name"
            android:textColor="#082561"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFinmateStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Status: Owed"
            android:textColor="#1abcab"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvFinmateAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount: ₹0"
            android:textColor="#1abcab"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ivFinmateArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=">"
        android:textColor="#082561"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>