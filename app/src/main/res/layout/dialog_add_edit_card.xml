<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:ignore="HardcodedText, ContentDescription">

    <!-- Premium Pill-shaped Drag Handle -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="2.5dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp" />

    <!-- Title Bar with Global Clear All Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvCardSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Credit Card"
            android:textColor="#101828"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Global Reset Button (Clears all fields) -->
        <ImageView
            android:id="@+id/btnClearAllFields"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/eraser" />
    </LinearLayout>

    <!-- Subtle Header Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F2F4F7" />

    <!-- Scrollable Form Inputs -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:maxHeight="550dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- 1. Card Name / Type -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:hint="Card Name (e.g., Millennia)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1abcab"
                app:hintTextColor="#1abcab">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSheetCardName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="24"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:textColor="#101828"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Bank Name (With dynamic clear button support via Material Design) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSheetBankName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:hint="Bank Name (e.g., State Bank of India)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1abcab"
                app:hintTextColor="#1abcab">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinSheetBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:popupBackground="@drawable/bg_rounded_popup"
                    android:completionThreshold="1"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:textColor="#101828"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>


            <!-- 3. Card Type Dropdown (Matches Bank Name style and behavior) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSheetCardType"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Card Type (e.g., Visa, RuPay)"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1abcab"
                app:hintTextColor="#1abcab">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinSheetCardType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:popupBackground="@drawable/bg_rounded_popup"
                    android:completionThreshold="1"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:textColor="#101828"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. Total Limit & Last 4 Digits & Billing Day Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="10dp">

                <!-- Total Limit -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="6dp"
                    android:hint="Total Limit"
                    app:prefixText="₹ "
                    app:prefixTextColor="#667085"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#1abcab"
                    app:hintTextColor="#1abcab">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSheetTotalLimit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:textColor="#101828"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Last 4 Digits -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:layout_marginEnd="6dp"
                    android:hint="Last 4 Digit"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#1abcab"
                    app:hintTextColor="#1abcab">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSheetLast4Digits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        android:gravity="center_horizontal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Billing Day -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:hint="Bill Day"
                    app:suffixText="/31"
                    app:suffixTextColor="#98A2B3"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#1abcab"
                    app:hintTextColor="#1abcab">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSheetBillingDay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:textColor="#101828"
                        android:textSize="14sp"
                        android:gravity="center_horizontal" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- 5. Professional Color Picker Grouping -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FAFAFA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#EAECF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical">

                    <!-- LEFT COLUMN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Card Theme Color"
                            android:textColor="#344054"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap the color box to change"
                            android:textColor="#667085"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- RIGHT COLUMN: Tools -->
                    <ImageView
                        android:id="@+id/btnResetColor"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:src="@drawable/reset" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardColorPreview"
                        android:layout_width="65dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#082561"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#EAECF0"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/edit"
                            app:tint="#FFFFFF" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetSaveCard"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Save Card"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                app:backgroundTint="#1abcab"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>