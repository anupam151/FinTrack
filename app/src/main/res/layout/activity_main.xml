<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText, TooManyViews, SmallSp, ContentDescription, UseCompoundDrawables, TooDeepLayout"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- MAIN CONTENT AREA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- FIXED TOP APP BAR -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topAppBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="6dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Hamburger Menu Icon -->
            <ImageView
                android:id="@+id/ivMenuDrawer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="1dp"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:text="Dashboard"
                android:textColor="#082561"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivMenuDrawer"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Right-Aligned Header Add Transaction Button -->
            <ImageButton
                android:id="@+id/btnAddTransactionHeader"
                android:layout_width="55dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/addtxn"
                android:scaleType="fitCenter"
                app:tint="#082561"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SCROLLABLE CONTENT AREA -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomNavigationWrapper"
            app:layout_constraintTop_toBottomOf="@+id/topAppBarContainer">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- Snapshot / Overview -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:layout_marginHorizontal="1dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="1dp"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="10dp"
                            android:weightSum="4">

                            <!-- Total Credit Cards -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="💳"
                                    android:textColor="#082561"
                                    android:textSize="22sp" />

                                <TextView
                                    android:id="@+id/tvLabelCards"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Total Cards"
                                    android:textColor="#082561"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvValueCards"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="2"
                                    android:textColor="#082561"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Total Limit -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="4dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="📦"
                                    android:textColor="#082561"
                                    android:textSize="22sp" />

                                <TextView
                                    android:id="@+id/tvLabelLimit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Total Limit"
                                    android:textColor="#082561"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvValueLimit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="₹3,48,000"
                                    android:textColor="#1abcab"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Total Used -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="4dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="📤"
                                    android:textColor="#082561"
                                    android:textSize="22sp" />
                                <TextView
                                    android:id="@+id/tvLabelUsed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Total Used"
                                    android:textColor="#082561"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvValueUsed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="₹1,57,480"
                                    android:textColor="#082561"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Total Due -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="📊"
                                    android:textColor="#082561"
                                    android:textSize="22sp" />
                                <TextView
                                    android:id="@+id/tvLabelDue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Total Due"
                                    android:textColor="#082561"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvValueDue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="₹26,768"
                                    android:textColor="#1abcab"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- COMBINED PARENT CONTAINER FOR CARDS & FINMATES -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#FAFFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="2dp"
                            android:paddingVertical="6dp">

                            <!-- SECTION 1: My Credit Cards -->
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="1dp">
                                <TextView
                                    android:id="@+id/tvSectionCardsTitle"
                                    android:text="Credit Card    [Latest Activity]"
                                    android:layout_marginStart="12dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:textColor="#082561"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/btnAddCard"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="More"
                                    android:padding="4dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/more"/>
                            </RelativeLayout>

                            <!-- Empty State: No Cards -->
                            <LinearLayout
                                android:id="@+id/layoutEmptyCards"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:visibility="visible">

                                <TextView
                                    android:id="@+id/tvEmptyCards"
                                    android:text="No card is added"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:textColor="#757575"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/btnAddCardEmpty"
                                    android:text="+  Add Card"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:background="?attr/selectableItemBackground"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="6dp"
                                    android:textColor="#1abcab"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Live Firestore Cards RecyclerView -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerViewCards"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:visibility="gone"
                                tools:listitem="@layout/item_dashboard_card" />

                            <!-- SECTION 2: Borrower/Lender Ledger -->
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="1dp">
                                <TextView
                                    android:id="@+id/tvSectionLedgerTitle"
                                    android:text="FinMate    [Latest Activity]"
                                    android:layout_marginStart="12dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:textColor="#082561"
                                    android:textSize="14sp"
                                    android:textStyle="bold"  />

                                <ImageButton
                                    android:id="@+id/btnAddPerson"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="More"
                                    android:padding="4dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/more"/>
                            </RelativeLayout>

                            <!-- Empty State: No FinMates -->
                            <LinearLayout
                                android:id="@+id/layoutEmptyFinMates"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:visibility="visible">

                                <TextView
                                    android:id="@+id/tvEmptyFinMates"
                                    android:text="No FinMate added"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:textColor="#757575"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/btnAddFinMateEmpty"
                                    android:text="+  Add FinMate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:background="?attr/selectableItemBackground"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="6dp"
                                    android:textColor="#1abcab"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- FinMates Container -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerViewFinMates"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:visibility="gone"
                                tools:listitem="@layout/item_dashboard_finmate" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Custom Bottom Navigation Bar -->
        <LinearLayout
            android:id="@+id/bottomNavigationWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:paddingHorizontal="8dp"
            android:baselineAligned="false"
            android:weightSum="4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Nav Item: Dashboard (Active) -->
            <LinearLayout
                android:id="@+id/navItemDashboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/ivNavDashboardIcon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:padding="7dp"
                    android:src="@drawable/dashboard" />
                <TextView
                    android:id="@+id/tvNavDashboardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dashboard"
                    android:textColor="#1abcab"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nav Item: Cards -->
            <LinearLayout
                android:id="@+id/navItemCards"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/ivNavCardsIcon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:padding="4dp"
                    android:src="@drawable/card_nav_bottom"/>
                <TextView
                    android:id="@+id/tvNavCardsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cards"
                    android:textColor="#082561"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Nav Item: Ledger -->
            <LinearLayout
                android:id="@+id/navItemLedger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/ivNavLedgerIcon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:padding="4dp"
                    android:src="@drawable/finmate"/>
                <TextView
                    android:id="@+id/tvNavLedgerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="FinMates"
                    android:textColor="#082561"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Nav Item: Reports -->
            <LinearLayout
                android:id="@+id/navSetings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/ivNavSettingsIcon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:padding="4dp"
                    android:src="@drawable/settings_nav"/>
                <TextView
                    android:id="@+id/tvNavSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Settings"
                    android:textColor="#082561"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- THE SIDE DRAWER VIEW -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="#082561"
        app:itemIconTint="@null"
        app:itemRippleColor="#E0E0E0"/>

</androidx.drawerlayout.widget.DrawerLayout>