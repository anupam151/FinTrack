<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.FinTrack" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">#082561</item>
        <item name="colorSecondary">#1ABCAB</item>

        <!-- Status Bar Configuration -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
    </style>

    <style name="Theme.FinTrack" parent="Base.Theme.FinTrack" />

    <!-- 1. The Theme Wrapper (Uses AppCompat to bypass the pink Material 3 tint) -->
    <style name="CleanPopupMenuTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="popupMenuStyle">@style/CustomPopupWidget</item>
        <item name="android:popupMenuStyle">@style/CustomPopupWidget</item>
    </style>

    <!-- 2. The Widget Style that forces the rounded corners and text color -->
    <style name="CustomPopupWidget" parent="Widget.AppCompat.PopupMenu">
        <!-- The rounded background -->
        <item name="android:popupBackground">@drawable/bg_rounded_popup</item>
        <!-- The Navy Blue text -->
        <item name="android:textColor">#082561</item>
        <!-- Adds elevation shadow -->
        <item name="android:popupElevation">8dp</item>
    </style>

</resources>