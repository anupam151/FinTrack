<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinTrack">

        <!-- Login Screen (Now the Launcher) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dashboard / Main Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings Screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Cards Screen -->
        <activity
            android:name=".CardsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FinMates Screen -->
        <activity
            android:name=".FinMatesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Transaction Screen -->
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- NEW: FinMate Ledger Screen -->
        <activity
            android:name=".FinMateLedgerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- NEW: Master Transaction Screen -->
        <activity
            android:name=".MasterTransactionsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>